# Copy to `.env` and fill in values.

# Pelican Panel base URL (no trailing slash preferred)
PELICAN_URL=https://panel.example.com

# Pelican *Application* API key (admin): typically starts with "papp_"
# Backs the pelican_app_* / pelican_ai_* tools. Optional if PELICAN_CLIENT_TOKEN is set.
PELICAN_TOKEN=papp_REPLACE_ME

# Pelican *Client / Account* API key: typically starts with "pacc_"
# Backs the pelican_client_* tools (power, console command, status, files, backups).
# Optional. If unset but PELICAN_TOKEN is a pacc_ key, it is reused for the client tools.
# At least one of PELICAN_TOKEN / PELICAN_CLIENT_TOKEN must be set.
PELICAN_CLIENT_TOKEN=pacc_REPLACE_ME

# Optional
PELICAN_TIMEOUT=30
PELICAN_VERIFY_SSL=true
PELICAN_USER_AGENT=PelicanMCP/0.1

# The generic PANEL_* names are also accepted as fallbacks (PANEL_URL, PANEL_TOKEN,
# PANEL_CLIENT_TOKEN, ...) if you're migrating an existing config.
